# API Configuration (empty in prod behind nginx same-origin)
VITE_API_URL=http://localhost:5001

# Optional CDN for /uploads (Cloudflare R2 custom domain, CloudFront, etc.)
# VITE_MEDIA_CDN_URL=https://cdn.loopera.ru

# Optional crash reporting (Sentry DSN)
